# Paste these variables into the staging2 Compose service's Environment tab.
# Generate fresh secret values for staging2; never copy development or staging values.
DEPLOY_ENV=staging2
PUBLIC_API_URL=https://api-staging2.rscapp.xyz
APP_VERSION=staging2
POSTGRES_PASSWORD=replace-with-a-staging2-only-random-value
REDIS_PASSWORD=replace-with-a-different-staging2-only-random-value
CORS_ORIGINS=https://staging2.rscapp.xyz,https://admin-staging2.rscapp.xyz,https://outlet-admin-staging2.rscapp.xyz
SWAGGER_ENABLED=true
PII_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32
PII_HASH_PEPPER=replace-with-output-of-openssl-rand-hex-32
OTP_PEPPER=replace-with-another-output-of-openssl-rand-hex-32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
ADMIN_INACTIVITY_TIMEOUT_SECONDS=1800
SMS_PROVIDER=sling
SLING_BASE_URL=https://app.sling.com.ng/api/v1
SLING_API_TOKEN=replace-with-a-staging2-sling-api-token
SLING_SENDER_ID=replace-with-an-approved-sender-id
SLING_MESSAGE_TYPE=transactional
SLING_TIMEOUT_MS=10000
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-a-staging2-gmail-address
SMTP_PASS=replace-with-a-staging2-app-password
SMTP_FROM=RSC <noreply@rscapp.xyz>
# Required only when EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
MEDIA_PROVIDER=noop
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rsc
PUSH_PROVIDER=firebase
FIREBASE_PROJECT_ID=replace-with-staging2-firebase-project-id
FIREBASE_CLIENT_EMAIL=replace-with-staging2-service-account-client-email
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_BASE64=replace-with-base64-encoded-staging2-service-account-private-key
PAYMENT_PROVIDER=local
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PLATFORM_COMMISSION_BPS=1000
VAT_BPS=750
DELIVERY_FEE_MINOR=150000
