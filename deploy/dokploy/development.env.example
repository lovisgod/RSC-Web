# Paste these variables into the development Compose service's Environment tab.
# Replace every placeholder with a development-only secret.
DEPLOY_ENV=development
PUBLIC_API_URL=https://api-dev.rscapp.xyz
APP_VERSION=development
POSTGRES_PASSWORD=replace-with-a-development-only-random-value
REDIS_PASSWORD=replace-with-a-different-development-only-random-value
CORS_ORIGINS=https://dev.rscapp.xyz,https://admin-dev.rscapp.xyz
SWAGGER_ENABLED=true
PII_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32
PII_HASH_PEPPER=replace-with-output-of-openssl-rand-hex-32
OTP_PEPPER=replace-with-another-output-of-openssl-rand-hex-32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
ADMIN_INACTIVITY_TIMEOUT_SECONDS=1800
SMS_PROVIDER=termii
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_API_KEY=replace-with-a-development-termii-api-key
TERMII_SENDER_ID=replace-with-an-approved-sender-id
TERMII_CHANNEL=dnd
TERMII_TIMEOUT_MS=10000
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-a-development-gmail-address
SMTP_PASS=replace-with-a-development-app-password
SMTP_FROM=RSC <noreply@rscapp.xyz>
# Required only when EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
PUSH_PROVIDER=firebase
FIREBASE_PROJECT_ID=replace-with-development-firebase-project-id
FIREBASE_CLIENT_EMAIL=replace-with-development-service-account-client-email
FIREBASE_PRIVATE_KEY=replace-with-development-service-account-private-key-with-escaped-newlines
PAYMENT_PROVIDER=local
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PLATFORM_COMMISSION_BPS=1000
VAT_BPS=750
DELIVERY_FEE_MINOR=150000
