  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Core User Journey SLOs (Rolling 5m Window)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 99.0 },
              { "color": "green", "value": 99.9 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.2.0",
      "targets": [
        {
          "expr": "(sum(rate(dineout_http_requests_total{route=\"/api/v1/payments/initiate\", status_code=~\"2..\"}[5m])) / sum(rate(dineout_http_requests_total{route=\"/api/v1/payments/initiate\", status_code!~\"4(00|01|03|22)\"}[5m]))) * 100",
          "legendFormat": "Checkout Availability",
          "refId": "A"
        }
      ],
      "title": "Checkout Availability (SLO: 99.9%)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 98.0 },
              { "color": "green", "value": 99.5 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "(sum(rate(dineout_http_requests_total{route=~\"/api/v1/(outlets|menu-items).*\", status_code=~\"[23]..\"}[5m])) / sum(rate(dineout_http_requests_total{route=~\"/api/v1/(outlets|menu-items).*\", status_code!~\"4[0-9]{2}\"}[5m]))) * 100",
          "legendFormat": "Catalog Availability",
          "refId": "A"
        }
      ],
      "title": "Catalog Availability (SLO: 99.5%)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1200 },
              { "color": "red", "value": 1500 }
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(dineout_http_request_duration_seconds_bucket{route=\"/api/v1/payments/initiate\"}[5m])) by (le)) * 1000",
          "legendFormat": "Checkout P95 Latency",
          "refId": "A"
        }
      ],
      "title": "Checkout P95 Latency (SLO: <1500ms)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 400 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(dineout_http_request_duration_seconds_bucket{route=~\"/api/v1/(outlets|menu-items).*\"}[5m])) by (le)) * 1000",
          "legendFormat": "Catalog P95 Latency",
          "refId": "A"
        }
      ],
      "title": "Catalog P95 Latency (SLO: <500ms)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 6,
      "title": "Traffic & Error Rates (The 4 Golden Signals)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 7,
      "title": "Traffic: Request Rate by Route (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(dineout_http_requests_total[1m])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 25
          },
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 8,
      "title": "Errors: 5xx Server Faults (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(dineout_http_requests_total{status_code=~\"5..\"}[1m])) by (route, status_code)",
          "legendFormat": "{{status_code}} - {{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 9,
      "title": "Latency Percentiles & Saturation",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 10,
      "title": "Latency Percentiles (API Overall)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(dineout_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50 (Median)",
          "refId": "P50"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(dineout_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P90",
          "refId": "P90"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(dineout_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95",
          "refId": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(dineout_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99",
          "refId": "P99"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 11,
      "title": "Saturation: Node.js Memory Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "dineout_process_resident_memory_bytes",
          "legendFormat": "Resident Memory (RSS)",
          "refId": "A"
        },
        {
          "expr": "dineout_nodejs_heap_size_used_bytes",
          "legendFormat": "Heap Used",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["dineout", "slo", "reliability"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "DineOut Platform SLO & RED Dashboard",
  "uid": "dineout-slo-dashboard",
  "version": 1
