{
  "name": "rsc-web-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @rsc/api dev",
    "dev:admin": "pnpm --filter @rsc/admin dev",
    "dev:outlet-admin": "pnpm --filter @rsc/outlet-admin dev",
    "dev:web": "pnpm --filter @rsc/web dev",
    "infra:up": "docker compose -f deploy/local/compose.yaml up -d",
    "infra:down": "docker compose -f deploy/local/compose.yaml down",
    "infra:logs": "docker compose -f deploy/local/compose.yaml logs -f",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "lint:admin": "pnpm --filter @rsc/admin lint",
    "lint:outlet-admin": "pnpm --filter @rsc/outlet-admin lint",
    "lint:web": "pnpm --filter @rsc/web lint",
    "lint:frontend": "pnpm --filter @rsc/admin --filter @rsc/outlet-admin --filter @rsc/web lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @rsc/api test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:reset:api": "sh scripts/reset-api-db.sh",
    "prepush": "sh scripts/pre-push.sh",
    "prepare": "node -e \"const{existsSync}=require('fs');const{execSync}=require('child_process');if(existsSync('scripts/install-git-hooks.sh')){try{execSync('sh scripts/install-git-hooks.sh',{stdio:'inherit'})}catch(_){}}\"",
    "clean": "turbo run clean && rm -rf .turbo"
  },
  "devDependencies": {
    "prettier": "3.8.4",
    "turbo": "2.9.18",
    "typescript": "5.9.3"
  }
}
