NODE_ENV=development
PORT=4000
APP_VERSION=development
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://locahost:5175
CUSTOMER_WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://rsc:rsc_local_password@localhost:5432/rsc
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
SWAGGER_ENABLED=true

# Development-only values. Generate unique production secrets as documented in docs/api.md.
PII_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PII_HASH_PEPPER=local-development-pii-hash-pepper-change-me
OTP_PEPPER=local-development-otp-pepper-change-me-now
JWT_SECRET=local-development-jwt-secret-change-me-32bytes-min
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
ADMIN_INACTIVITY_TIMEOUT_SECONDS=1800

OWNER_NAME=RSC Owner
OWNER_EMAIL=owner@example.com
OWNER_PHONE=08030000000
OWNER_PASSWORD=

DATABASE_BACKUP_MAX_ATTACHMENT_MB=20

SMS_PROVIDER=noop
SLING_BASE_URL=https://app.sling.com.ng/api/v1
SLING_API_TOKEN=
SLING_SENDER_ID=
SLING_MESSAGE_TYPE=transactional
SLING_TIMEOUT_MS=10000

# Use "smtp" and provide SMTP credentials to send real registration emails.
# Defaults to Gmail SMTP (smtp.gmail.com:587). Enable 2FA and use an App Password.
EMAIL_PROVIDER=noop
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RSC <noreply@rscapp.xyz>

EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=RSC <hello@rscdev.tech>
RESEND_REPLY_TO=noreply@rscdev.tech

# Use "cloudinary" and provide credentials to upload menu images, avatars, and future media.
MEDIA_PROVIDER=noop
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rsc

# Use "firebase" and provide service account credentials to send push notifications.
PUSH_PROVIDER=firebase
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=replace-with-service-account-client-email
FIREBASE_PRIVATE_KEY=replace-with-service-account-private-key-with-escaped-newlines

# Backend address autocomplete. Google is the default; OpenCage is fallback.
ADDRESS_AUTOCOMPLETE_PROVIDER=google
GOOGLE_MAPS_API_KEY=
OPENCAGE_API_KEY=
OPENCAGE_BASE_URL=https://api.opencagedata.com/geocode/v1/json

# Payment adapter. Use "paystack" when Paystack credentials are available; "local" records dev success.
# PAYSTACK_WEBHOOK_SECRET is the same value as PAYSTACK_SECRET_KEY — Paystack signs webhooks
# with the merchant secret key using HMAC-SHA512.
PAYMENT_PROVIDER=local
# PAYSTACK_SECRET_KEY=
# PAYSTACK_BASE_URL=https://api.paystack.co
# PAYSTACK_WEBHOOK_SECRET=   # same as PAYSTACK_SECRET_KEY
PLATFORM_COMMISSION_BPS=1000      # 10% in basis points
VAT_BPS=750                    # 7.5% in basis points
DELIVERY_FEE_MINOR=150000      # ₦1,500.00 in kobo

MOMENT_SECRET_KEY=
MOMENT_BASE_URL=https://api.momentpay.net
MOMENT_WEBHOOK_SECRET=
MOMENT_SETTLEMENT_REPORT_PATH=/settlements/report

PREPARATION_SUGGESTIONS_AI_PROVIDER=pollinations
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_TEXT_MODEL=openai
POLLINATIONS_API_KEY=
# Alternative free-route provider:
# PREPARATION_SUGGESTIONS_AI_PROVIDER=openrouter
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_API_KEY=
PREPARATION_SUGGESTIONS_AI_TIMEOUT_MS=4000
